{
    "name": "caydeesoft/whatsapp",
    "description": "A robust Laravel package for integrating with the Meta WhatsApp Cloud API, supporting messaging, webhooks, and media handling.",
    "keywords": ["laravel", "whatsapp", "meta", "cloud api", "messaging", "webhooks"],
    "type": "library",
    "homepage": "https://github.com/caydeesoft/whatsapp",
    "license": "MIT",

    "authors": [
        {
            "name": "Dennis K Kiptugen",
            "email": "dennis.kiptoo@caydeesoft.com",
            "homepage": "https://www.caydeesoft.com",
            "role": "Maintainer"
        }
    ],

    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4|^8.5",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.0"
    },

    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "mockery/mockery": "^1.6"
    },

    "autoload": {
        "psr-4": {
            "Caydeesoft\\WhatsApp\\": "src/"
        }
    },

    "autoload-dev": {
        "psr-4": {
            "Caydeesoft\\WhatsApp\\Tests\\": "tests/"
        }
    },

    "extra": {
        "laravel": {
            "providers": [
                "Caydeesoft\\WhatsApp\\WhatsAppServiceProvider"
            ],
            "aliases": {
                "WhatsApp": "Caydeesoft\\WhatsApp\\Facades\\WhatsApp"
            }
        }
    },

    "minimum-stability": "stable",
    "prefer-stable": true,

    "support": {
        "issues": "https://github.com/caydeesoft/whatsapp/issues",
        "source": "https://github.com/caydeesoft/whatsapp"
    },

    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
